{
  "name": "cargo-manifest-webapp",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Docker-hosted webapp build of the Cargo Manifest Star Citizen hauling planner (client-side only, no server-side user data).",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "dev": "npm run sync-data && vite",
    "build": "npm run sync-data && vite build",
    "preview": "vite preview --port 8080",
    "check": "npm run sync-data && svelte-check --tsconfig ./tsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^5.0.3",
    "@tsconfig/svelte": "^5.0.4",
    "svelte": "^5.19.0",
    "svelte-check": "^4.1.4",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}
